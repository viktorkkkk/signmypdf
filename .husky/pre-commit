#!/usr/bin/env sh

# Regenerate per-page sitemap lastmod from staged + committed git history,
# then stage the JSON so it ships in the same commit as the page changes.
# See scripts/generate-lastmod.mjs for how staged files get a `now` mtime
# instead of the previous-commit mtime.
node scripts/generate-lastmod.mjs >/dev/null
git add app/lastmod.generated.json
